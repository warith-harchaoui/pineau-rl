license: BSD-3-Clause
repository-code: "https://github.com/warith-harchaoui/pineau-rl"
url: "https://deraison.ai/en/blog/listen-to-joelle-pineau"
keywords:
  - reinforcement learning
  - reproducibility
  - statistics
  - meta-research
  - MuJoCo
  - GRPO
