}

/* Comparatif du paysage : tableau compact (11 critères), ligne du paquet mise
   en avant et liste « une ligne par outil ». */
:where(.drz-p-blog__SLUG) .drz-star-table--compact{
   min-width: 0;
   table-layout: fixed;
   width: 100%
}

:where(.drz-p-blog__SLUG) .drz-star-table--compact th,:where(.drz-p-blog__SLUG) .drz-star-table--compact td{
   padding: 8px 4px
}

:where(.drz-p-blog__SLUG) .drz-star-table--compact thead th{
   white-space: normal;
   width: 78px;
   line-height: 1.2;
   font-size: 11.5px;
   hyphens: auto;
   -webkit-hyphens: auto
}

:where(.drz-p-blog__SLUG) .drz-star-table--compact thead th:first-child,:where(.drz-p-blog__SLUG) .drz-star-table--compact tbody th{
   white-space: normal;
   width: 140px;
   hyphens: none;
   -webkit-hyphens: none
}

:where(.drz-p-blog__SLUG) .drz-star-table--compact .drz-stars{
   font-size: 12.5px;
   letter-spacing: 0
}

:where(.drz-p-blog__SLUG) .drz-star-table tbody tr.is-self th,:where(.drz-p-blog__SLUG) .drz-star-table tbody tr.is-self td{
   background: #fbfbe8
}

:where(.drz-p-blog__SLUG) .drz-star-table tbody tr.is-self th{
   font-weight: 700
}

/* Framer impose white-space:pre-wrap a .drz-text ; les retours a la ligne et
   l'indentation de la source se voyaient dans les elements de liste. */
:where(.drz-p-blog__SLUG) .drz-tool-list,:where(.drz-p-blog__SLUG) .drz-tool-list li,:where(.drz-p-blog__SLUG) .drz-tool-list li *{white-space:normal}
:where(.drz-p-blog__SLUG) .drz-article-content ul.drz-tool-list{
   list-style: none;
   margin: 10px 0 6px;
   padding: 0;
   font-size: 15px;
   line-height: 1.55;
   color: #333
}

:where(.drz-p-blog__SLUG) .drz-article-content ul.drz-tool-list>li{
   position: relative;
   margin: 0 0 12px;
   padding: 0;
   padding-inline-start: 22px
}

:where(.drz-p-blog__SLUG) .drz-article-content ul.drz-tool-list>li::before{
   content: "";
   position: absolute;
   left: 4px;
   top: 9px;
   width: 6px;
   height: 6px;
   border-radius: 50%;
   background: #cfcfcf
}

:where(.drz-p-blog__SLUG) .drz-article-content ul.drz-tool-list>li.is-self{
   background: #fbfbe8;
   border-radius: 6px;
   padding: 8px 10px 8px 22px;
   margin-left: -10px
}

:where(.drz-p-blog__SLUG) .drz-article-content ul.drz-tool-list>li.is-self::before{
   background: #111;
   left: 10px;
   top: 17px
}

:where(.drz-p-blog__SLUG) .drz-article-content ul.drz-tool-list strong{
   color: #111
}

/* Appels de référence en exposant : sans cette règle, le a.drz-text
   intérieur reprend la taille pleine du corps (--ui-font-size) et le
   numéro s'affiche deux fois trop gros. line-height:0 pour ne pas creuser
   l'interligne de la ligne porteuse. */
:where(.drz-p-blog__SLUG) .drz-article-content sup.drz-ref{
   font-size: .55em;
   line-height: 0;
   position: relative;
   vertical-align: baseline;
   top: -.55em
}

:where(.drz-p-blog__SLUG) .drz-article-content sup.drz-ref a.drz-text{
   font-size: inherit !important
}
:where(.drz-p-blog__SLUG) .drz-art-fig--portrait img{
   max-width: 360px;
   margin-inline: auto
}

/* Sommaire à douze entrées : « 10. » déborde de la colonne de numéro taillée pour un chiffre (même correctif que 4ml dans site.css). */
.drz-p-blog__SLUG .drz-article-content .drz-art-toc ol > li{
   padding-inline-start: 32px
}

.drz-p-blog__SLUG .drz-article-content .drz-art-toc ol > li::before{
   width: 24px
}

/* Le tableau de la remesure a cinq colonnes de mots : l'en-tête de ligne passe
   à la ligne au lieu d'écraser les autres colonnes, et le tableau garde assez
   de largeur pour défiler proprement sur téléphone. */
.drz-p-blog__SLUG .drz-doc-table{
   min-width: 680px
}

.drz-p-blog__SLUG .drz-doc-table tbody th{
   white-space: normal;
   font-family: inherit;
   font-size: 13.5px;
   min-width: 170px
}

.drz-p-blog__SLUG .drz-doc-table caption{
   caption-side: top;
   text-align: left;
   font-size: 13px;
   color: #666;
   padding: 0 12px 8px
}


/* Credit line under the article: two logo-and-name links, no underline (Warith, 2026-11-21) */
:where(.drz-p-blog__SLUG) p.drz-art-credit.drz-text{
   text-align: center;
   font-size: 14px;
   color: #777;
   margin: 40px 0 8px
}
:where(.drz-p-blog__SLUG) .drz-art-credit-link{
   color: #333;
   font-weight: 600;
   text-decoration: none;
   white-space: nowrap;
   transition: color .15s
}
:where(.drz-p-blog__SLUG) .drz-art-credit-link:hover{
   color: #000;
   text-decoration: none
}
:where(.drz-p-blog__SLUG) .drz-art-credit-link img{
   display: inline-block;
   width: 1.15em;
   height: 1.15em;
   margin: 0 .3em 0 .15em;
   vertical-align: -0.2em;
   object-fit: contain
}

/* Figure captions: their links wrap like the text around them (the site sets links to nowrap) */
:where(.drz-p-blog__SLUG) .drz-art-figcap a,
:where(.drz-p-blog__SLUG) .drz-art-figcap a.drz-text{
   white-space: normal !important;
   overflow-wrap: anywhere
}

/* Hero: the portrait of Joelle Pineau under the lede, with its credit (CC BY 3.0) */
:where(.drz-p-blog__SLUG) .drz-photo-hero{
   display: flex;
   flex-direction: column;
   align-items: center;
   gap: 12px;
   width: 100%;
   max-width: 1120px;
   margin: 0 auto 48px;
   padding: 0 24px;
   box-sizing: border-box
}
:where(.drz-p-blog__SLUG) .drz-photo-hero img{
   width: min(100%, 560px);
   height: auto;
   border-radius: 16px;
   display: block
}
:where(.drz-p-blog__SLUG) p.drz-hero-credit.drz-text{
   font-size: 13px;
   color: #777;
   text-align: center;
   max-width: 560px;
   margin: 0
}
:where(.drz-p-blog__SLUG) .drz-hero-credit a,
:where(.drz-p-blog__SLUG) .drz-hero-credit a.drz-text{
   white-space: normal !important
}
